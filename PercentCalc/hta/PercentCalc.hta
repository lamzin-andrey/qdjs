	<body>
		<div id="placer">
			<title>HTA Калькулятор процентов</title>
			<hta:application id="htaCheckFilesSum" 
				applicationName="htaCheckFilesSum" 
				icon="i/icons/chSum2.ico"
				
				mycommnoframe="caption=No;border=None"
					mycommcaption="No"
					mycomminnerborder="no"
					scroll="no"
					mycommborder="None"
				
				mycommfixed=""
					border="dialog"
					maximizebutton="No"
					minimizebutton="No"
			/>
		</div>
		<!--OBJECT ID="WebBrowser" WIDTH=0 HEIGHT=0 CLASSID="clsid:8856F961-340A-11D0-A96B-00C04FD705A2"></OBJECT-->

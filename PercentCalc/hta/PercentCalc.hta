		<div class="wrk xp">
			<div>
				<label>Значение:</label>
				<input type="text" id="iTotal" value="0">
			</div>
			<div>
				<label>Проценты:</label>
				<input type="text" id="iPercent" value="0">
			</div>
			<div>
				<label>Результат:</label>
				<input type="text" id="iResult" value="0">
			</div>
		</div>
			
	
